# Variables de entorno de Apparchar. Copia este archivo como .env y llena los valores.
# .env NUNCA se sube al repositorio (está en .gitignore). Aquí van solo los nombres.
#
# Entrega 2: el prototipo (web/) y el servidor simulado (Prism) no necesitan
# ninguna variable. Estas son las que va a leer el backend desde la Entrega 3.

# Puerto HTTP del backend. Ejemplo de formato: 3000
PORT=

# Entorno de ejecución: development | test | production
NODE_ENV=

# Cadena de conexión a PostgreSQL 17.
# Formato: postgres://USUARIO:CLAVE@SERVIDOR:5432/BASE
DATABASE_URL=

# Verificación de los tokens JWT (Bearer) del organizador, que también valida en la puerta (D-13).
# Emisor (claim iss), audiencia (claim aud) y URL del conjunto de claves públicas (JWKS).
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Clave compartida con la pasarela de pagos: confirmarPagoOrden la exige en la
# cabecera X-Clave-Pasarela (decisiones D-13 y D-20). Solo la conoce el servidor.
PASARELA_CLAVE=

# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
CORS_ORIGIN=

# Minutos que una orden pendiente reserva cupo antes de expirar. Ejemplo de formato: 15
ORDEN_MINUTOS_RESERVA=
